  "cards": [
    {
      "dot": "cyan",
      "title": "Presentacion y estado",
      "items": [
        "DiscoverScreen: 4 feeds + selector seasonal; feed con PageView.builder y refresh.",
        "Player: play/pause + caption expandible (110 px). Controles: likes, vistas, mute; favoritos.",
        "Provider: loadNextPage(), refreshFeed(), loadMoreForSection(), toggleLike(); primer video 0/0."
      ]
    },
    {
      "dot": "violet",
      "title": "Clean Architecture y datos",
      "items": [
        "VideoPost: campos id a isLiked; copyWith(), toJson(), fromJson().",
        "Contratos: getTrendingVideosByPage(page) y getFavoriteVideosByUser(userID); RepositoryImpl inyecta datasource.",
        "Cloudinary, Pixabay y Pexels + fallback; metricas likes <= views < 1000.",
        "SharedPreferences + LocalVideoModel(JSON); SeasonConfig audio/icono; AppTheme oscuro.",
        "getFavoriteVideosByUser() TODO; LocalStorageService y RandomVideoMetrics no estan versionados en Practica04."
      ]
    }
  ]
