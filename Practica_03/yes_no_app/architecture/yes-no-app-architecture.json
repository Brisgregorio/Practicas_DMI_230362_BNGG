  "cards": [
    {
      "dot": "amber",
      "title": "Verified behavior / requirement gap",
      "items": [
        "The app chooses text locally and sends force to the API. It does not derive text from the returned answer.",
        "One Message preserves text/image pairing, but API agreement is not validated. YesNoModel is unused."
      ]
    },
    {
      "dot": "rose",
      "title": "Not implemented",
      "items": [
        "HTTP error handling, response field validation, image URL validation and image errorBuilder.",
        "Fallback reply, API loading state, retry and error recovery. No answer-value enum."
      ]
    },
    {
      "dot": "cyan",
      "title": "Implemented guards and loading",
      "items": [
        "Empty string ignored; non-question remains a user message without an API request. Whitespace is not trimmed.",
        "Image loadingBuilder only. notifyListeners and ScrollController refresh and scroll the chat."
      ]
    }
  ]
